# Copie para .env e ajuste. NUNCA versione o .env real.

APP_NAME="WFM Segurança Patrimonial"
ENV=development

# PoC (SQLite). Produção (VPS Hostinger):
# DATABASE_URL=postgresql+psycopg2://wfm:senha@localhost:5432/wfm
DATABASE_URL=sqlite:///./wfm.db

# Gere com: openssl rand -hex 32
SECRET_KEY=troque-isto-em-producao

# Homem-morto. Para TESTAR rápido, use 1 minuto:
DEADMAN_INTERVAL_MINUTES=30
DEADMAN_JITTER_MINUTES=5
DEADMAN_RESPONSE_WINDOW_SECONDS=120

# Geofence / anti fake-gps
DEFAULT_GEOFENCE_RADIUS_M=100
MAX_PLAUSIBLE_SPEED_MPS=30

# Liveness: stub | aws_rekognition
LIVENESS_PROVIDER=stub
FACE_MATCH_THRESHOLD=0.90
LIVENESS_THRESHOLD=0.80
AWS_REGION=sa-east-1

# Webhook da central (homem-morto perdido / pânico)
CENTRAL_WEBHOOK_URL=

CORS_ORIGINS=*
